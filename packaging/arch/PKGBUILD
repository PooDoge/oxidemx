# Maintainer: PooDoge <dev@chewyswap.dog>
# Contributor: JuhLabs (Julian Hermstad) — original JuhRadial MX project
# Arch Linux PKGBUILD for OxideMX

pkgname=oxidemx
pkgver=0.3.2
pkgrel=1
pkgdesc="Radial menu, DPI control and haptics for Logitech MX Master mice on Linux"
arch=('x86_64')
url="https://github.com/PooDoge/oxidemx"
license=('GPL3')
depends=(
    'gtk4'
    'gtk4-layer-shell'
    'libadwaita'
    'dbus'
    'libevdev'
    'hidapi'
)
makedepends=(
    'rust'
    'cargo'
    'git'
)
optdepends=(
    'ydotool: for cursor capture and input injection on Wayland'
)
provides=("$pkgname")
conflicts=("$pkgname-git" 'juhradial-mx')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"

    # Build the whole Rust workspace (daemon, overlay, settings, popup)
    cargo build --release --locked --workspace \
        --exclude spike-iced --exclude iced_gtk_themer
}

package() {
    cd "$pkgname-$pkgver"

    # Install binaries
    install -Dm755 target/release/oxidemxd "$pkgdir/usr/bin/oxidemxd"
    install -Dm755 target/release/oxidemx-overlay "$pkgdir/usr/bin/oxidemx-overlay"
    install -Dm755 target/release/oxidemx-settings "$pkgdir/usr/bin/oxidemx-settings"
    install -Dm755 target/release/oxidemx-popup "$pkgdir/usr/bin/oxidemx-popup"

    # Install launcher script
    install -Dm755 scripts/oxidemx.sh "$pkgdir/usr/bin/oxidemx"

    # Install assets
    install -dm755 "$pkgdir/usr/share/oxidemx/assets"
    cp -r assets/* "$pkgdir/usr/share/oxidemx/assets/"

    # Install desktop files
    install -Dm644 packaging/oxidemx.desktop "$pkgdir/usr/share/applications/oxidemx.desktop"
    install -Dm644 packaging/org.oxidemx.settings.desktop "$pkgdir/usr/share/applications/org.oxidemx.settings.desktop"

    # Install icon
    install -Dm644 assets/oxidemx.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/oxidemx.svg"

    # Install systemd user service
    install -Dm644 packaging/systemd/oxidemx-daemon.service "$pkgdir/usr/lib/systemd/user/oxidemx-daemon.service"

    # Install udev rules
    install -Dm644 packaging/udev/99-oxidemx.rules "$pkgdir/usr/lib/udev/rules.d/99-oxidemx.rules"
    install -Dm644 packaging/udev/70-oxidemx-haptic-pad.rules "$pkgdir/usr/lib/udev/rules.d/70-oxidemx-haptic-pad.rules"
    install -Dm644 packaging/udev/60-ydotool-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-ydotool-uinput.rules"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Install docs
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CONTRIBUTING.md "$pkgdir/usr/share/doc/$pkgname/CONTRIBUTING.md"
}

post_install() {
    echo ">>> To start OxideMX:"
    echo "    systemctl --user enable --now oxidemx-daemon"
    echo "    oxidemx"
    echo ""
    echo ">>> Or find 'OxideMX' in your application menu"
}

post_upgrade() {
    post_install
}
