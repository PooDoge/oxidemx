{
  "name": "oxidemx-gnome-extensions",
  "version": "0.0.1",
  "private": true,
  "description": "Build target for the OxideMX GNOME shell extensions (oxidemx-cursor, oxidemx-indicator).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@girs/gjs": "latest",
    "@girs/gnome-shell": "latest",
    "@girs/meta-15": "latest",
    "@girs/gio-2.0": "latest",
    "@girs/glib-2.0": "latest",
    "@girs/gtk-4.0": "latest",
    "@girs/adw-1": "latest"
  }
}
