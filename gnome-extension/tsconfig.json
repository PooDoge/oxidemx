{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "esModuleInterop": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".",
    "rootDir": ".",
    "types": [
      "@girs/gjs",
      "@girs/gnome-shell",
      "@girs/meta-15",
      "@girs/gio-2.0",
      "@girs/glib-2.0",
      "@girs/gtk-4.0",
      "@girs/adw-1"
    ]
  },
  "include": [
    "juhradial-cursor@dev.juhlabs.com/**/*.ts",
    "juhradial-indicator@dev.juhlabs.com/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}
