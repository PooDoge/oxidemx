{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "esModuleInterop": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "gi://Gio": ["./node_modules/@girs/gio-2.0/gio-2.0-ambient.d.ts"],
      "gi://GLib": ["./node_modules/@girs/glib-2.0/glib-2.0-ambient.d.ts"],
      "gi://Meta": ["./node_modules/@girs/meta-15/meta-15-ambient.d.ts"],
      "gi://Gtk": ["./node_modules/@girs/gtk-4.0/gtk-4.0-ambient.d.ts"],
      "gi://Adw": ["./node_modules/@girs/adw-1/adw-1-ambient.d.ts"],
      "resource:///org/gnome/shell/extensions/extension.js": [
        "./node_modules/@girs/gnome-shell/dist/extensions/extension-ambient.d.ts"
      ],
      "resource:///org/gnome/shell/extensions/prefs.js": [
        "./node_modules/@girs/gnome-shell/dist/extensions/prefs-ambient.d.ts"
      ],
      "resource:///org/gnome/shell/ui/main.js": [
        "./node_modules/@girs/gnome-shell/dist/ui/main-ambient.d.ts"
      ],
      "resource:///org/gnome/shell/ui/panelMenu.js": [
        "./node_modules/@girs/gnome-shell/dist/ui/panelMenu-ambient.d.ts"
      ],
      "resource:///org/gnome/shell/ui/popupMenu.js": [
        "./node_modules/@girs/gnome-shell/dist/ui/popupMenu-ambient.d.ts"
      ],
      "gi://GObject": [
        "./node_modules/@girs/gobject-2.0/gobject-2.0-ambient.d.ts"
      ],
      "gi://St": [
        "./node_modules/@girs/st-16/st-16-ambient.d.ts"
      ],
      "gi://Clutter": [
        "./node_modules/@girs/clutter-16/clutter-16-ambient.d.ts"
      ]
    },
    "types": [
      "@girs/gjs",
      "@girs/gnome-shell"
    ]
  },
  "include": [
    "juhradial-cursor@dev.juhlabs.com/**/*.ts",
    "juhradial-indicator@dev.juhlabs.com/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}
